{
  "name": "contract-hawk-frontend",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "generate:api": "openapi-generator-cli generate -i ../contracts/openapi/contract-hawk-api.yaml -g typescript-angular -o src/app/api/generated"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.22.3 <27",
    "npm": ">=11 <13"
  },
  "dependencies": {
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vitest": "4.1.10"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.3",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2"
  }
}
